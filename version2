    except Exception as e:
        print(e)

# ---------- Slash Command ----------
@bot.tree.command(name="setup", description="Sets up the server safely, Community-mode compatible")
@app_commands.default_permissions(administrator=True)
async def setup(interaction: discord.Interaction):
    await interaction.response.send_message("Setting up the server...", ephemeral=True)
    guild = interaction.guild

    # Detect Community system channels
    rules_channel = guild.rules_channel
    public_updates_channel = guild.public_updates_channel

    # ---------- Create Roles ----------
    for role_name, color, hoist, perms in roles_info:
        existing_role = discord.utils.get(guild.roles, name=role_name)
        if existing_role is None:
            role = await guild.create_role(name=role_name, colour=color, hoist=hoist, permissions=perms)

    # ---------- Create Categories and Channels ----------
    for category_name, channels in categories_channels.items():
        category = discord.utils.get(guild.categories, name=category_name)
        if category is None:
            category = await guild.create_category(category_name)

        existing_channels = {ch.name.lower(): ch for ch in category.channels}

        for channel in channels:
            channel_name = channel["name"]
            is_private = channel["private"]

            # Skip Community system channels
            if rules_channel and channel_name.lower().replace("📜-","") == rules_channel.name.lower():
                continue
            if public_updates_channel and channel_name.lower().replace("📢-","") == public_updates_channel.name.lower():
                continue

            base_name = ''.join(c for c in channel_name if c.isalnum()).lower()
            found = None
            for existing in existing_channels.values():
                existing_base = ''.join(c for c in existing.name if c.isalnum()).lower()
                if existing_base == base_name:
                    found = existing
                    break

            # Prepare overwrites for private channels
            overwrites = {}

            # For private channels (except verify)
            if category_name != "🛈 Info" and channel_name != "🔒-verify":
                # Block everyone from accessing the channel by default
                overwrites[guild.default_role] = discord.PermissionOverwrite(view_channel=False)

                # Allow the Member role to view the channel
                member_role = discord.utils.get(guild.roles, name="👥 Members")
                if member_role:
                    overwrites[member_role] = discord.PermissionOverwrite(view_channel=True)

                # Allow Staff roles to view the channel
                staff_roles = [
                    "👑 Owner", "🔥 Co-Owner", "⚡ Head Administrator", "🛡️ Admin", "👑 Head Moderator", "🧰 Moderator"
                ]
                for role_name_staff in staff_roles:
                    role = discord.utils.get(guild.roles, name=role_name_staff)
                    if role:
                        overwrites[role] = discord.PermissionOverwrite(view_channel=True)

            # Create or rename the channel
            if found:
                if found.category != category:
                    await found.edit(category=category)  # Move the channel
                await found.edit(name=channel_name, overwrites=overwrites)
            else:
                if category_name == "🔊 Voice Channels":
                    await guild.create_voice_channel(channel_name, category=category, overwrites=overwrites)
                else:
                    await guild.create_text_channel(channel_name, category=category, overwrites=overwrites)

    await interaction.followup.send("Server setup complete! ✅", ephemeral=True)

